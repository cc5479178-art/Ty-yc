{
  "name": "craftnest",
  "version": "1.0.0",
  "description": "Handmade ornaments store with Stripe checkout, WhatsApp alert links, email notifications and an owner dashboard.",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm run build:client",
    "build:client": "npm --prefix client run build",
    "postinstall": "npm --prefix client install && npm --prefix client run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "stripe": "^16.6.0"
  }
}
