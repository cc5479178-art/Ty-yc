# ---- Server ----
PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
DB_FILE=./data.sqlite

# ---- Owner (you) ----
# Email that receives order + registration alerts (needs SMTP below)
OWNER_EMAIL=you@example.com
# Your WhatsApp number in full international format, digits only (e.g. 919876543210)
OWNER_WHATSAPP=919876543210

# ---- Admin account (seeded on first run) ----
ADMIN_EMAIL=admin@craftnest.local
ADMIN_PASSWORD=change-this-password

# ---- Stripe (https://dashboard.stripe.com/apikeys) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
CURRENCY=inr

# ---- SMTP for email alerts (e.g. Gmail app password: smtp.gmail.com 587) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CraftNest <you@example.com>
